# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*

# Environment variables
.env
.env.local

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
.tmp/

# Job archive — stored in jobs-archive-private repo, not here
.github/data/archive/

# Legacy enriched descriptions — superseded by chunked files seeded from jobs-data-2026
# INF-7: aggregator only uses -1/-2 chunks (seed step). Legacy file must not be committed.
.github/data/descriptions-enriched.jsonl

# Enriched description chunks are seeded from R2/jobs-data at runtime.
# Keeping them tracked in aggregator HEAD bloats checkout without improving recovery.
.github/data/descriptions-enriched-*.jsonl

# All description sidecars are runtime-seeded from R2/jobs-data.
# They are needed locally during runs, but not as tracked source files in AGG HEAD.
.github/data/descriptions-*.jsonl